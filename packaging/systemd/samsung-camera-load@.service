# SPDX-License-Identifier: GPL-3.0-only
[Unit]
Description=Initialize Samsung VG-STC3000 RAM firmware at USB %I
# No BindsTo: successful RAM boot removes the boot-state USB device.

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/samsung-camera load /usr/local/share/samsung-camera/FalconFW.bin /dev/bus/usb/%I
TimeoutStartSec=5min
Restart=no
# Do not keep instances active: USB addresses can be reused after reconnect.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/bus/usb/%I rw
